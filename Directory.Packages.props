<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Lowest supported versions of the runtime dependencies that flow into the published packages. The regular
    PackageVersion entries below track the latest versions (Renovate bumps them); building with
    -p:UseLowestSupportedDependencies=true (the "lowest-dependencies" job in ci.yml) swaps them for these floors so
    CI proves the code still compiles and passes its tests against the oldest versions we claim to support.
    Raise a floor only when the code starts to need something newer. Build and test tooling is not overridden.
  -->
  <PropertyGroup>
    <MinModelContextProtocolVersion>2.3.1</MinModelContextProtocolVersion>
    <MinToonDotNetVersion>4.1.1</MinToonDotNetVersion>
    <MinMicrosoftExtensionsVersion>10.0.0</MinMicrosoftExtensionsVersion>
    <MinMicrosoftExtensionsAIAbstractionsVersion>10.0.0</MinMicrosoftExtensionsAIAbstractionsVersion>
    <MinSystemTextJsonVersion>10.0.1</MinSystemTextJsonVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="DotNet.ReproducibleBuilds" Version="2.0.5" />
    <PackageVersion Include="Hangfire.Core" Version="1.8.25" />
    <PackageVersion Include="Hangfire.InMemory" Version="1.0.0" />
    <PackageVersion Include="Hangfire.SqlServer" Version="1.8.25" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.3" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.GitHubActionsReport" Version="2.5.3" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <PackageVersion Include="ModelContextProtocol" Version="2.3.1" />
    <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageVersion Include="PolySharp" Version="1.17.1" />
    <PackageVersion Include="System.Text.Json" Version="11.0.0" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="Toon.DotNet" Version="4.1.1" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLowestSupportedDependencies)' == 'true'">
    <PackageVersion Update="ModelContextProtocol" Version="$(MinModelContextProtocolVersion)" />
    <PackageVersion Update="Toon.DotNet" Version="$(MinToonDotNetVersion)" />
    <PackageVersion Update="Microsoft.Extensions.AI.Abstractions" Version="$(MinMicrosoftExtensionsAIAbstractionsVersion)" />
    <PackageVersion Update="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MinMicrosoftExtensionsVersion)" />
    <PackageVersion Update="Microsoft.Extensions.Hosting" Version="$(MinMicrosoftExtensionsVersion)" />
    <PackageVersion Update="Microsoft.Extensions.Logging" Version="$(MinMicrosoftExtensionsVersion)" />
    <PackageVersion Update="Microsoft.Extensions.Logging.Abstractions" Version="$(MinMicrosoftExtensionsVersion)" />
    <PackageVersion Update="Microsoft.Bcl.AsyncInterfaces" Version="$(MinSystemTextJsonVersion)" />
    <PackageVersion Update="System.Text.Json" Version="$(MinSystemTextJsonVersion)" />
  </ItemGroup>
</Project>
