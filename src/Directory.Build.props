<Project>

  <!--
    Shared packaging metadata for every publishable library under src/. Kept out of the individual
    csproj files so version bumps and metadata changes happen in one place. Samples and tests live
    outside src/ and are unaffected (each already sets <IsPackable>false</IsPackable> explicitly, and
    MSBuild only walks up from a project's own directory to find Directory.Build.props, so this file
    is never picked up by samples/ or tests/).
  -->
  <PropertyGroup>
    <Authors>dotnet-agent-surface contributors</Authors>
    <Company>dotnet-agent-surface contributors</Company>
    <PackageProjectUrl>https://github.com/sommmen/dotnet-agent-surface</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sommmen/dotnet-agent-surface</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>agent;mcp;model-context-protocol;cli;ai;llm</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CS1591 (missing XML doc comment) is intentionally suppressed for now: GenerateDocumentationFile
      is still worth enabling (it produces the .xml IntelliSense file shipped in the package), but the
      public surface doesn't have full XML doc coverage yet. Revisit once docs are written.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    Automated, git-height-based semantic versioning (see ../version.json) plus deterministic,
    reproducible builds with normalized source paths and GitHub-flavored SourceLink. These flow to
    every packable project under src/ so no individual csproj needs to reference them directly.
  -->
  <PropertyGroup>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' OR '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94" PrivateAssets="all" />
    <PackageReference Include="DotNet.ReproducibleBuilds" Version="2.0.5" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="all" />
  </ItemGroup>

</Project>
