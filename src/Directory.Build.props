<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Shared packaging metadata for every publishable library under src/. Kept out of the individual
    csproj files so version bumps and metadata changes happen in one place. Samples and tests live
    outside src/ and are unaffected by this file (each already sets <IsPackable>false</IsPackable>
    explicitly, and MSBuild only walks up from a project's own directory to find Directory.Build.props,
    so this file is never picked up by samples/ or tests/). Only the root Directory.Build.props, which
    carries TreatWarningsAsErrors alone, is shared with them.
  -->
  <PropertyGroup>
    <GitVersionBaseDirectory>$(MSBuildThisFileDirectory)..</GitVersionBaseDirectory>
    <Authors>dotnet-agent-surface contributors</Authors>
    <Company>dotnet-agent-surface contributors</Company>
    <PackageProjectUrl>https://github.com/sommmen/dotnet-agent-surface</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sommmen/dotnet-agent-surface</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>agent;mcp;model-context-protocol;cli;ai;llm</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      CS1591 (missing XML doc comment) is intentionally suppressed for now: GenerateDocumentationFile
      is still worth enabling (it produces the .xml IntelliSense file shipped in the package), but the
      public surface doesn't have full XML doc coverage yet. Revisit once docs are written.
    -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    API compatibility gate against the latest published nuget.org preview (checked on `dotnet pack`).
    Bump PackageValidationBaselineVersion after a release that is meant to become the new baseline; intentional
    0.x breaks are recorded in each project's CompatibilitySuppressions.xml (see CHANGELOG.md, "Package validation").
  -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.1.81-preview</PackageValidationBaselineVersion>
  </PropertyGroup>

  <!--
    Automated, git-height-based semantic versioning (see ../version.json) plus deterministic,
    reproducible builds with normalized source paths and GitHub-flavored SourceLink. These flow to
    every packable project under src/ so no individual csproj needs to reference them directly.
  -->
  <PropertyGroup>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' OR '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
    <PackageReference Include="DotNet.ReproducibleBuilds" PrivateAssets="all" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

</Project>
