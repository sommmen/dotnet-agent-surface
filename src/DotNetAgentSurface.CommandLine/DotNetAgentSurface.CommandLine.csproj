<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DotNetAgentSurface.Core\DotNetAgentSurface.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>DotNetAgentSurface.CommandLine</PackageId>
    <Description>Generates a token-efficient, AXI-style command-line adapter over a DotNetAgentSurface operation catalog, including TOON output, JSON mode, and confirmation-policy enforcement.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.14.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.1" />
  </ItemGroup>

  <!--
    Toon.DotNet (https://github.com/CharlesHunt/ToonDotNet) declares dependency groups for net8.0, net9.0,
    net10.0, net11.0, and netstandard2.0, so it is referenced unconditionally here. ToonAgentOutputRenderer.cs
    calls it directly on both target frameworks, which is why the netstandard2.0 System.Text.Json reference
    above is pinned to the same version Toon.DotNet itself depends on for that target framework.
  -->
  <ItemGroup>
    <PackageReference Include="Toon.DotNet" Version="1.7.3" />
  </ItemGroup>

</Project>
