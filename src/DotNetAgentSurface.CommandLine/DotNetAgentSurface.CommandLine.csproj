<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DotNetAgentSurface.Core\DotNetAgentSurface.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>DotNetAgentSurface.CommandLine</PackageId>
    <Description>Generates a token-efficient, AXI-style command-line adapter over a DotNetAgentSurface operation catalog, including TOON output, JSON mode, and confirmation-policy enforcement.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="PolySharp" Version="1.14.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!--
    ToonEncoder (Cysharp) only declares a net10.0 dependency group on NuGet (versions 1.0.0-2.0.0); there is no
    netstandard2.0-compatible build. It is therefore referenced only for the net10.0 target framework.
    ToonAgentOutputRenderer.cs uses `#if NET10_0` to call it directly on net10.0 and falls back to a small
    hand-written TOON writer covering the subset of shapes AXI output needs (primitives, objects, arrays of
    primitives, and flat/uniform object arrays) on netstandard2.0, so TOON stays the default output format on
    both target frameworks behind the same IAgentOutputRenderer abstraction.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="ToonEncoder" Version="2.0.0" />
  </ItemGroup>

</Project>
