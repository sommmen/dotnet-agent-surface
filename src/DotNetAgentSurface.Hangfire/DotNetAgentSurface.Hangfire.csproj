<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>DotNetAgentSurface.Hangfire</PackageId>
    <Description>Discovers Hangfire recurring jobs and exposes safe, on-demand triggers through a DotNetAgentSurface operation catalog.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetAgentSurface.Core\DotNetAgentSurface.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.Core" Version="1.8.18" />
    <PackageReference Include="Hangfire.InMemory" Version="0.9.0" />
    <!-- Hangfire.Core 1.8.18 transitively selects vulnerable Newtonsoft.Json 11.0.1 on netstandard2.0. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="PolySharp" Version="1.14.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
