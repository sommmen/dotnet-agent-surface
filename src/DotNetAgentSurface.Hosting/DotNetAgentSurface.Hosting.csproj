<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DotNetAgentSurface.Core\DotNetAgentSurface.Core.csproj" />
    <ProjectReference Include="..\DotNetAgentSurface.CommandLine\DotNetAgentSurface.CommandLine.csproj" />
    <ProjectReference Include="..\DotNetAgentSurface.Mcp\DotNetAgentSurface.Mcp.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>DotNetAgentSurface.Hosting</PackageId>
    <Description>Dual-surface Microsoft.Extensions.Hosting application for DotNetAgentSurface: one executable and one dependency-injection composition that serves an MCP stdio server by default and a plain, ergonomic command-line interface through a verb.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

</Project>
