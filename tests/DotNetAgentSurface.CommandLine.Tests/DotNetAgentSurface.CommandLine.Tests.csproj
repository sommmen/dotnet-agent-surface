<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net8.0 is included alongside net10.0 so this suite also executes against the netstandard2.0 build of
      DotNetAgentSurface.CommandLine: net8.0 isn't in that project's TargetFrameworks list, so NuGet/MSBuild
      resolves the reference to its nearest compatible asset, netstandard2.0, exercising that compatibility
      path (e.g. the ToonAgentOutputRenderer implementation) at test time instead of only at compile time.
    -->
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Microsoft.Testing.Extensions.GitHubActionsReport" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotNetAgentSurface.Core\DotNetAgentSurface.Core.csproj" />
    <ProjectReference Include="..\..\src\DotNetAgentSurface.CommandLine\DotNetAgentSurface.CommandLine.csproj" />
  </ItemGroup>

</Project>
