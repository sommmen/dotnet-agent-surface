<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Hangfire.SqlServer is pinned to the exact Hangfire.Core version referenced by
         DotNetAgentSurface.Hangfire so both packages resolve a single, consistent
         Hangfire.Core version. -->
    <PackageReference Include="Hangfire.SqlServer" Version="1.8.25" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.2" />
    <!-- Hangfire.Core 1.8.25 still selects vulnerable Newtonsoft.Json 11.0.1 transitively; pin the
         same remediated version DotNetAgentSurface.Hangfire already carries. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Provisions a throwaway SQL Server container for opt-in local/CI compatibility runs. -->
    <PackageReference Include="Testcontainers.MsSql" Version="4.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- xunit v2 has no built-in runtime skip; SkippableFact lets tests self-report "skipped"
         (instead of failing) when the opt-in environment variable is unset or Docker is unavailable. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotNetAgentSurface.Hangfire\DotNetAgentSurface.Hangfire.csproj" />
  </ItemGroup>

</Project>
