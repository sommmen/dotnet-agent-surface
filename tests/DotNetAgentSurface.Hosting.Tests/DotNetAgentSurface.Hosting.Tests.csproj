<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Microsoft.Testing.Extensions.GitHubActionsReport" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotNetAgentSurface.Hosting\DotNetAgentSurface.Hosting.csproj" />
    <ProjectReference Include="..\..\samples\DotNetAgentSurface.Samples.CliAndMcp\DotNetAgentSurface.Samples.CliAndMcp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SampleHostPath</_Parameter1>
      <_Parameter2>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', 'samples', 'DotNetAgentSurface.Samples.CliAndMcp', 'bin', '$(Configuration)', '$(TargetFramework)', 'tasktracker.dll'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
